# Copy to .env and fill in.
ETH_ADDRESS=0xA7c5516d130B4393C49B06D2312aE0Efe0463FBe
AGENT_NAME=tututlemot

# Supabase anon key (public, from nocoin.live/play).
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImJxcmFwbmxxcXRqZWRqeWhsZmNpIiwicm9sZSI6ImFub24iLCJpYXQiOjE3NzgyNzUyNjQsImV4cCI6MjA5Mzg1MTI2NH0.mf0fz6kAnK0yeAXrb-XT6yikbdRmeAq5jsikVPPhaFE

# Polling pace (seconds between GETs when there's no puzzle ready)
IDLE_POLL_SECONDS=60
# Seconds between pulls when actively mining (keep >=1.25s to respect 8 req / 10s cap)
ACTIVE_POLL_SECONDS=1.5

# Optional: set to 1 to enable extra verbose logging
VERBOSE=0

# ---------------------------------------------------------------------------
# LLM fallback (optional but HIGHLY recommended — unlocks quantum/CS/weird
# trivia puzzles that the deterministic solver can't handle).
# ---------------------------------------------------------------------------

# Set LLM_API_KEY and (optionally) LLM_BASE_URL + LLM_MODEL. Any
# OpenAI-compatible endpoint works.
#
# OpenAI (default):
#   LLM_BASE_URL=https://api.openai.com/v1
#   LLM_MODEL=gpt-4o-mini
#
# Groq (fast + cheap):
#   LLM_BASE_URL=https://api.groq.com/openai/v1
#   LLM_MODEL=llama-3.3-70b-versatile
#
# OpenRouter (many models):
#   LLM_BASE_URL=https://openrouter.ai/api/v1
#   LLM_MODEL=anthropic/claude-3.5-sonnet
#
# DeepSeek:
#   LLM_BASE_URL=https://api.deepseek.com/v1
#   LLM_MODEL=deepseek-chat
#
# Local Ollama (free):
#   LLM_BASE_URL=http://localhost:11434/v1
#   LLM_MODEL=llama3.1:8b
#   LLM_API_KEY=ollama       # any non-empty string

# LLM_API_KEY=
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini
# LLM_TIMEOUT=45
# LLM_ENABLED=1
