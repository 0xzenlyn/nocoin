# Copy to .env and fill in.
ETH_ADDRESS=0xA7c5516d130B4393C49B06D2312aE0Efe0463FBe
AGENT_NAME=tututlemot

# Supabase anon key (public, from nocoin.live/play).
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImJxcmFwbmxxcXRqZWRqeWhsZmNpIiwicm9sZSI6ImFub24iLCJpYXQiOjE3NzgyNzUyNjQsImV4cCI6MjA5Mzg1MTI2NH0.mf0fz6kAnK0yeAXrb-XT6yikbdRmeAq5jsikVPPhaFE

# Polling pace
IDLE_POLL_SECONDS=60
ACTIVE_POLL_SECONDS=1.5

# HTTP timeouts. Supabase edge functions can cold-start slowly (30+ s) on the
# first hit — raise HTTP_READ_TIMEOUT if you see ReadTimeout errors.
HTTP_CONNECT_TIMEOUT=15
HTTP_READ_TIMEOUT=90
MAX_RETRIES=10

# Optional: set to 1 to enable extra verbose logging
VERBOSE=0

# ---------------------------------------------------------------------------
# LLM fallback (HIGHLY recommended — unlocks quantum / CS / crypto-history
# puzzles that the deterministic solver can't handle).
#
# Any OpenAI-compatible endpoint works. Pick ONE and uncomment.
# ---------------------------------------------------------------------------

# ---- Recommended for maximum accuracy ----

# OpenAI o4-mini (reasoning, best for logic/math/quantum puzzles)
# LLM_API_KEY=sk-...
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=o4-mini

# OpenAI gpt-4o (general knowledge champion)
# LLM_API_KEY=sk-...
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o

# Anthropic Claude via OpenRouter (best reasoning, long context)
# LLM_API_KEY=sk-or-...
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_MODEL=anthropic/claude-sonnet-4.5

# ---- Best value (strong + cheap) ----

# DeepSeek Reasoner (R1-class reasoning, very cheap)
# LLM_API_KEY=sk-...
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_MODEL=deepseek-reasoner

# DeepSeek Chat (V3, fast + cheap)
# LLM_API_KEY=sk-...
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_MODEL=deepseek-chat

# ---- FREE tier ----

# Groq llama-3.3-70b (free, fastest on the planet, good for 80% of puzzles)
# LLM_API_KEY=gsk_...
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=llama-3.3-70b-versatile

# Groq qwen 2.5 (alternative on Groq free tier)
# LLM_API_KEY=gsk_...
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=qwen-2.5-72b

# ---- Local (zero cost, needs GPU) ----

# Ollama
# LLM_API_KEY=ollama
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=qwen2.5:14b

# ---- Shared knobs ----

# LLM_TIMEOUT=60
# LLM_MAX_TOKENS=1024
# LLM_TEMPERATURE=0
# LLM_ENABLED=1

# Fallback chain: if the primary model answers empty, try these in order.
# Comma-separated model IDs (same provider / base URL).
# LLM_FALLBACK_MODELS=gpt-4o-mini,gpt-4o
